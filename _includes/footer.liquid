{% capture footer_contents %}
  &copy; {{ site.time | date: '%Y' }} {{ site.first_name }}{% if site.middle_name and site.middle_name != '' %} {{ site.middle_name }}{% endif %} {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
  <span class="site-views" data-site-views data-locale="{{ page.lang | default: 'en' }}" hidden>
    <span>{% if page.lang == 'zh' %}浏览次数：{% else %}Page views: {% endif %}<span data-view-total></span></span>
    <span class="site-views__base" data-view-base-note hidden>{% if page.lang == 'zh' %}（含初始基数 <span data-view-base></span>，非历史实测）{% else %}(includes an initial base of <span data-view-base></span>, not measured historical traffic){% endif %}</span>
  </span>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
<script defer src="{{ '/assets/js/site-views.js' | relative_url | bust_file_cache }}"></script>
