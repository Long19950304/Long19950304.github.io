{% assign podcast = site.data.podcasts[include.id] %}
{% if podcast and podcast.editions %}
  {% include paper_audio.liquid podcast=podcast %}
{% else %}
{% if podcast and podcast.audio %}
  {% assign podcast_ui = site.data.i18n[page.lang].podcast | default: site.data.i18n.en.podcast %}
  {% assign take_home_text = podcast.take_home %}
  {% if page.lang == 'zh' and podcast.take_home_zh %}{% assign take_home_text = podcast.take_home_zh %}{% endif %}
  {% assign audio_path = podcast.audio | prepend: "/" %}
  {% assign audio_file = site.static_files | where: "path", audio_path | first %}
  {% if audio_file %}
    <div class="podcast-block">
      {% if take_home_text %}
        <div class="podcast-takehome"><strong>{{ podcast_ui.take_home_label }}</strong> {{ take_home_text }}</div>
      {% endif %}
      <div class="podcast-guidance">{{ podcast_ui.hint }} {{ podcast_ui.guidance }}</div>
      <div class="podcast-audio">
        {% include audio.liquid path=podcast.audio controls=true preload="none" %}
      </div>
    </div>
  {% endif %}
{% endif %}
{% endif %}
