[Unit]
Description=Zhilong course showcase likes API
After=network.target
[Service]
Type=simple
User=zhaozhilong
Group=zhaozhilong
WorkingDirectory=/opt/zhaozhilong-api
Environment=LIKES_DB=/var/lib/zhaozhilong/likes.sqlite3
Environment=CORS_ORIGIN=https://www.zhaozhilong.com
Environment=API_HOST=127.0.0.1
Environment=API_PORT=8080
ExecStart=/usr/bin/python3 /opt/zhaozhilong-api/app.py
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
