<div class="publications recent-publications">
  {% for publication in site.data.recent_publications %}
    <div class="recent-publications__entry">
      <p class="recent-publications__date">
        {% if page.lang == 'zh' %}{% if publication.accepted %}已接收{% elsif publication.online %}在线发表{% else %}正式发表{% endif %}{% else %}{% if publication.accepted %}Accepted{% elsif publication.online %}Published online{% else %}Published{% endif %}{% endif %}
        · <time datetime="{{ publication.date }}">{{ publication.date }}</time>
      </p>
      {% bibliography --file {{ publication.file }} --group_by none --query @article[key={{ publication.key }}] %}
    </div>
  {% endfor %}
</div>
<p class="recent-publications__all"><a href="{% if page.lang == 'zh' %}{{ '/zh/publications/' | relative_url }}{% else %}{{ '/publications/' | relative_url }}{% endif %}">{% if page.lang == 'zh' %}查看全部论文与会议报告{% else %}View all publications and presentations{% endif %} <span aria-hidden="true">→</span></a></p>
