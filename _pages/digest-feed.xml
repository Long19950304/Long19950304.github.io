---
layout: null
permalink: /digest/feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>Zhilong Zhao — Daily Digest</title>
    <link>{{ '/digest/' | absolute_url }}</link>
    <description>Daily China and world economy, technology and research briefing with English audio and attributable sources.</description>
    <language>en</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {% assign digests = site.digests | where_exp: "d", "d.archived != true" | sort: "name" | reverse %}
    {% for d in digests limit: 50 %}
      {% assign date_key = d.digest_date | date: '%Y-%m-%d' %}
      {% assign meta = site.data.digests[date_key] %}
      {% assign tagline = meta.note %}
      {% if tagline == nil or tagline == "" %}
        {% assign tagline = meta.items[0].title %}
      {% endif %}
    <item>
      <title>{{ d.title | xml_escape }}</title>
      <link>{{ d.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ d.url | absolute_url }}</guid>
      <pubDate>{{ d.digest_date | date_to_rfc822 }}</pubDate>
      <description>{{ tagline | default: "" | strip | truncate: 240 | xml_escape }}</description>
      {% if meta.audio.en %}<enclosure url="{{ meta.audio.en.path | absolute_url | xml_escape }}?v={{ meta.audio.en.sha256 | slice: 0, 12 }}" length="{{ meta.audio.en.bytes }}" type="audio/mpeg" />{% endif %}
    </item>
    {% endfor %}
  </channel>
</rss>
