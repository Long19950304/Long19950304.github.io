---
layout: default
---
<div class="post post-about">
  <header class="post-header post-header--hero">
    <div class="about-identity">
      <h1 class="post-title">
        {% assign lang = page.lang | default: site.lang | default: "en" %}
        {% if site.title == 'blank' %}
          {% assign chinese_name = site.chinese_name | default: "" %}
          {% capture english_name %}<span class="font-weight-bold">{{ site.first_name }}</span>{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
          {% if chinese_name != "" %}
            {% if lang == "zh" %}
              <span class="font-weight-bold">{{ chinese_name }}</span>（{{ english_name }}）
            {% else %}
              {{ english_name }} ({{ chinese_name }})
            {% endif %}
          {% else %}
            {{ english_name }}
          {% endif %}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      <p class="desc">{{ page.subtitle }}</p>
      {% if page.profile.more_info %}
        <div class="about-contact">{{ page.profile.more_info }}</div>
      {% endif %}
    </div>
    {% if page.profile.image %}
      <div class="about-avatar">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% assign profile_image_class = 'img-fluid' %}
        {% if page.profile.image_circular %}
          {% assign profile_image_class = profile_image_class | append: ' rounded-circle' %}
        {% endif %}
        {% if page.profile.pixel_art %}
          {% assign profile_image_class = profile_image_class | append: ' pixel-art-avatar' %}
        {% endif %}
        {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes="(max-width: 575px) 72px, 104px" alt="Zhilong Zhao" cache_bust=true avoid_scaling=page.profile.pixel_art %}
      </div>
    {% endif %}
  </header>

  <article>
    <div class="about-content clearfix">{{ content }}</div>

    {% include site_updates.liquid %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest Posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Recent publications -->
    {% if page.recent_publications %}
      <h2 id="recent-publications">
        {% if lang == 'zh' %}<a href="{{ '/zh/publications/' | relative_url }}" style="color: inherit">近期成果</a>{% else %}<a href="{{ '/publications/' | relative_url }}" style="color: inherit">Recent Publications</a>{% endif %}
      </h2>
      {% include recent_publications.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
