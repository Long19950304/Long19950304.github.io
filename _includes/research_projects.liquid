{% assign project_lang = page.lang | default: 'en' %}
{% for section in site.data.research_grants.sections %}
<h2 id="{{ section.id }}">{{ section.title[project_lang] }}</h2>
{% if section.note %}<p>{{ section.note[project_lang] }}</p>{% endif %}
<ul>
  {% for project in section.items %}
  <li><p><strong>{{ project.title[project_lang] }}</strong>
    {% assign project_meta = '' | split: ',' %}
    {% if project.programme %}{% assign project_meta = project_meta | push: project.programme[project_lang] %}{% endif %}
    {% if project.number %}{% assign project_meta = project_meta | push: project.number %}{% endif %}
    {% if project.period %}
      {% assign project_period = project.period[project_lang] | default: project.period %}
      {% assign project_meta = project_meta | push: project_period %}
    {% endif %}
    {% if project.status %}{% assign project_meta = project_meta | push: project.status[project_lang] %}{% endif %}
    {% if project_meta.size > 0 %}<br>{{ project_meta | join: ' · ' }}{% endif %}
    {% if project.lead %}<br>{% if project_lang == 'zh' %}主持：{% else %}Principal investigator: {% endif %}{{ project.lead[project_lang] }}{% endif %}
    {% if project.description %}<br>{{ project.description[project_lang] }}{% endif %}
  </p></li>
  {% endfor %}
</ul>
{% endfor %}
